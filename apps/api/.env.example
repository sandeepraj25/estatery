NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/estatery
# Shared secret with apps/web (same value as API_INTERNAL_KEY there). Generate: openssl rand -hex 32
INTERNAL_API_KEY=96af9c0bdde7d6144df7aa84297d4f9b59e0869bf3b0156e7c7e1b2b3f5e81d8
CORS_ORIGINS=http://localhost:3000
PLATFORM_DOMAIN=localhost
TENANT_CACHE_TTL_MS=60000

# Access-token signing secret. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-32-plus-character-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE=true   # defaults to true when NODE_ENV=production
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# SMTP_URL=smtps://user:pass@smtp.example.com:465   # unset: emails are printed to the API log in development
MAIL_FROM=Estatery <no-reply@your-domain.com>

# Media storage: "local" (dev / single server) or "s3" (S3, R2, Spaces, MinIO)
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./.uploads
MEDIA_MAX_UPLOAD_MB=12
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.your-domain.com

# Custom domains
DOMAIN_CNAME_TARGET=sites.estatery.app
# DOMAIN_A_RECORDS=203.0.113.10          # server IPv4s for root domains
DNS_RESOLVERS=1.1.1.1,8.8.8.8
DOMAIN_MAX_PER_TENANT=5
DOMAIN_CLAIM_HOURS=72
DOMAIN_RECHECK_MINUTES=360
DOMAIN_LOST_AFTER_FAILURES=3
# Certificates: "caddy" (on-demand TLS, see deploy/Caddyfile), "cloudflare" (Cloudflare for SaaS) or "vercel"
TLS_PROVIDER=caddy
TLS_ASK_TOKEN=replace-with-a-long-random-string
# Vercel hosting (TLS_PROVIDER=vercel): verified agency domains are added to the Vercel project.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=prj_...
# VERCEL_TEAM_ID=team_...
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Background jobs and rate limits
# With REDIS_URL set, emails, lead notifications and follow-up reminders run on a BullMQ queue
# (retried with backoff) and rate limits are shared across API instances. Without it, jobs run
# inline in the API process — fine for a single small server, not for production.
# REDIS_URL=redis://127.0.0.1:6379
# Set RUN_WORKERS=false on API instances when you run `node dist/worker.js` separately.
RUN_WORKERS=true
# Port of the web app in development, used to build links in emails.
DEV_WEB_PORT=3000

# Subscriptions (Razorpay)
# Set all three to take real payments (rzp_test_… keys use Razorpay's test mode). Plans are created
# in Razorpay automatically on first checkout. Webhook URL: https://<platform domain>/api/webhooks/razorpay
# with events: subscription.* and payment.failed.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Without keys (and outside production) a built-in payment simulator runs instead. "false" turns billing off.
BILLING_SIMULATOR=true
# Re-sync subscriptions from Razorpay every N minutes in case a webhook was missed (0 = off).
BILLING_RECONCILE_MINUTES=360
PLATFORM_NAME=Estatery

# Error reporting (optional): unexpected errors and jobs that fail all retries.
# Without a DSN they are written as JSON lines to stderr. No request bodies or cookies are sent.
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# Shown in /health and error reports (e.g. the git commit).
APP_VERSION=dev
