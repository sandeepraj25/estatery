{
  "name": "@estatery/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch --enable-source-maps dist/main.js\"",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/scripts/seed.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:vercel": "node vercel/build.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@estatery/shared": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/node": "^10.76.2",
    "@vercel/functions": "^3.10.3",
    "bullmq": "^6.3.19",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "files": [
    "dist"
  ]
}
