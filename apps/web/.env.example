# Server-only. Never prefix these with NEXT_PUBLIC_.
API_URL=http://127.0.0.1:4000
# Same value as INTERNAL_API_KEY in apps/api/.env
API_INTERNAL_KEY=replace-with-the-api-internal-key

# Error reporting (optional). Unexpected server errors and error screens are reported here;
# without it they are written as JSON lines to stderr.
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# APP_VERSION=2026.10.21

# Platform root domain (same as the API's PLATFORM_DOMAIN); shown when creating agencies.
PLATFORM_DOMAIN=localhost
